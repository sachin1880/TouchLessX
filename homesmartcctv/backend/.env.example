# Environment: development | production
ENVIRONMENT=development

# PostgreSQL connection string
# Local (Homebrew Postgres): postgresql+psycopg://smarthome:smarthome@localhost:5432/smarthome_camera
# Docker Compose (service name as host): postgresql+psycopg://smarthome:smarthome@db:5432/smarthome_camera
DATABASE_URL=postgresql+psycopg://smarthome:smarthome@localhost:5432/smarthome_camera

# JWT signing secret - generate a long random value, e.g. `openssl rand -hex 32`
# NEVER commit a real secret. This is a placeholder only.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins (mobile dev servers, etc.)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

# A device is considered OFFLINE if no heartbeat has arrived within this many seconds.
# Should be roughly 2x the mobile app's heartbeat interval (20-30s) plus buffer.
HEARTBEAT_OFFLINE_THRESHOLD_SECONDS=60

# Battery percentage below which a LOW_BATTERY event is raised (once, until it recovers)
LOW_BATTERY_THRESHOLD_PERCENT=15

# Comma-separated STUN/TURN server URLs for WebRTC NAT traversal (handed to clients via
# GET /api/webrtc/ice-servers). Google's public STUN server is free; add a TURN server
# here later (e.g. self-hosted coturn) if direct peer-to-peer fails on restrictive networks.
STUN_SERVERS=stun:stun.l.google.com:19302

# Where event-capture snapshots (viewer-triggered photos) are stored on disk, and how many
# days they're kept before being deleted for good. This is not a video-storage service -
# only manually captured stills are saved, and only briefly.
MEDIA_ROOT=media
CAPTURE_RETENTION_DAYS=2

# How long continuous-recording video segments are kept before being deleted for good.
# The camera uploads one ~60s clip at a time while streaming - this is not meant to
# replace a real NVR, so retention is kept short.
VIDEO_RETENTION_DAYS=2
